<script>
(function(){
  function byId(id){return document.getElementById(id)}
  function money(id){return parseMoney(byId(id)?.value||0)}
  function numberVal(id){return Number(String(byId(id)?.value||0).replace(',','.'))||0}
  function safeFmt(n){return Math.round(Math.max(0,Number(n)||0)).toLocaleString('cs-CZ')+' Kč'}
  function safeMil(n){return (Math.round((Number(n)||0)/100000)/10).toLocaleString('cs-CZ')+' mil.'}
  function setText(id,value){const el=byId(id); if(el) el.textContent=value}
  function monthsToLabel(month){return month ? Math.ceil(month/12)+'. rok' : 'nedosáhne'}

  function annuityPayment(amount, annualRate, years){
    const n=Math.max(1,Math.round(years*12));
    const r=(annualRate/100)/12;
    if(!r) return amount/n;
    return amount*r/(1-Math.pow(1+r,-n));
  }

  function mortgageModel(){
    if(typeof buildMortgageSeries==='function'){
      try{return buildMortgageSeries()}catch(e){}
    }
    const amount=money('mortgageAmount'), years=numberVal('mortgageYears'), rate=numberVal('mortgageRate');
    const p=annuityPayment(amount,rate,years), n=Math.max(1,Math.round(years*12)), r=rate/100/12;
    const lump=money('mortgageLumpInvest'), monthly=money('mortgageMonthlyInvest'), y=numberVal('mortgageInvestYield')/100/12;
    const targetRent=Math.max(money('rent1'),money('rent2'));
    let debt=amount, invest=lump, cross=null, safePayoff=null, baseEndInvestment=0;
    const series=[];
    for(let m=0;m<=n;m++){
      if(m>0){debt=Math.max(0,debt*(1+r)-p); invest=invest*(1+y)+monthly;}
      if(!cross && invest>=debt) cross={month:m,investment:invest,debt:debt};
      if(!safePayoff && invest-debt>=targetRent) safePayoff={month:m,investment:invest,debt:debt};
      if(m%12===0 || m===n) series.push({year:m/12,debt,investment:invest,payoffInvestment:null});
      if(m===n) baseEndInvestment=invest;
    }
    let payoffEndInvestment=null;
    if(cross){
      let inv=Math.max(0,cross.investment-cross.debt);
      for(let m=cross.month+1;m<=n;m++) inv=inv*(1+y)+monthly+p;
      payoffEndInvestment=inv;
      const map=new Map(series.map(s=>[Math.round(s.year*12),s]));
      inv=Math.max(0,cross.investment-cross.debt);
      for(let m=cross.month;m<=n;m++){
        if(m>cross.month) inv=inv*(1+y)+monthly+p;
        if(m%12===0 || m===n){const row=map.get(m); if(row) row.payoffInvestment=inv;}
      }
      series.forEach(row=>{if(row.year*12<cross.month) row.payoffInvestment=null});
    }
    return {amount,years,rate,payment:p,series,cross,safePayoff,baseEndInvestment,payoffEndInvestment};
  }

  function rentAt(age){
    const until=numberVal('rent1Until');
    return age < until ? money('rent1') : money('rent2');
  }

  function capitalForMonthlySchedule(startAge,endAge, monthlyFn, yieldRate){
    const r=(yieldRate||0)/12;
    const months=Math.max(1,Math.round((endAge-startAge)*12));
    let pv=0;
    for(let m=1;m<=months;m++){
      const age=startAge+m/12;
      const rent=monthlyFn(age);
      pv += rent/Math.pow(1+r,m);
    }
    return pv;
  }

  function reportRiskNumbers(){
    const currentAge=numberVal('age');
    const endAge=Math.max(currentAge+1,numberVal('endAge'));
    const currentAssets=money('current')+money('lump');
    const invalidPension=money('riskInvalidPension');
    const widow=money('riskWidowPension');
    const orphan=money('riskOrphanPension');
    const children=Math.max(0,numberVal('riskChildren'));
    const familyPensions=widow+orphan*children;
    const expenses=money('riskExpenses');
    const otherLoans=money('riskOtherLoans');
    const mortgage=mortgageModel();
    const post=(numberVal('post')||0)/100;
    const invalidGap=Math.max(0,Math.max(money('rent1'),money('rent2'))-money('rentalIncome')-invalidPension);
    const invalidCapital=capitalForMonthlySchedule(currentAge,endAge,(age)=>Math.max(0,rentAt(age)-money('rentalIncome')-invalidPension),post);
    // U smrti se počítá s doplacením jistiny hypotéky zvlášť. Měsíční výpadek rodiny proto pracuje s výdaji domácnosti a ostatními úvěry bez hypoteční splátky.
    const deathGap=Math.max(0,expenses+otherLoans-familyPensions);
    const deathIncomeCapital=capitalForMonthlySchedule(currentAge,endAge,()=>deathGap,post);
    const deathCapital=(mortgage.amount||0)+deathIncomeCapital;
    const invalidCover=Math.max(0,invalidCapital-currentAssets-money('riskCurrentInvalidCover'));
    const deathCover=Math.max(0,deathCapital-currentAssets-money('riskCurrentDeathCover'));
    return {currentAge,endAge,currentAssets,invalidPension,familyPensions,expenses,otherLoans,mortgage,invalidGap,invalidCapital,deathGap,deathIncomeCapital,deathCapital,invalidCover,deathCover};
  }

  function drawLine(canvas, series, keys){
    if(!canvas) return;
    const ctx=canvas.getContext('2d'), W=canvas.width, H=canvas.height, pad=44;
    ctx.clearRect(0,0,W,H);
    ctx.fillStyle='#fff';ctx.fillRect(0,0,W,H);
    const vals=[]; series.forEach(d=>keys.forEach(k=>{const v=d[k.key]; if(v!==null && v!==undefined && isFinite(v)) vals.push(v)}));
    const max=Math.max(...vals,1)*1.15;
    ctx.strokeStyle='#e4eaf3';ctx.lineWidth=1;ctx.font='14px -apple-system';ctx.fillStyle='#687891';
    for(let i=0;i<=3;i++){const y=pad+(H-pad*2)*i/3;ctx.beginPath();ctx.moveTo(pad,y);ctx.lineTo(W-pad,y);ctx.stroke();ctx.fillText(safeMil(max-(max*i/3)),8,y+5)}
    const maxX=Math.max(...series.map(d=>d.x),1);
    keys.forEach(k=>{
      const pts=series.filter(d=>d[k.key]!==null && d[k.key]!==undefined && isFinite(d[k.key]));
      if(!pts.length) return;
      ctx.strokeStyle=k.color;ctx.lineWidth=4;ctx.beginPath();
      pts.forEach((d,i)=>{const x=pad+(W-pad*2)*(d.x/maxX);const y=pad+(H-pad*2)*(1-d[k.key]/max); if(i===0)ctx.moveTo(x,y); else ctx.lineTo(x,y)});
      ctx.stroke();
    });
  }

  function drawBars(canvas,bars){
    if(!canvas) return;
    const ctx=canvas.getContext('2d'), W=canvas.width, H=canvas.height, pad=44;
    ctx.clearRect(0,0,W,H); ctx.fillStyle='#fff';ctx.fillRect(0,0,W,H);
    const max=Math.max(...bars.map(b=>b.value),1)*1.25;
    ctx.strokeStyle='#e4eaf3';ctx.lineWidth=1;
    for(let i=0;i<=3;i++){const y=pad+(H-pad*2)*i/3;ctx.beginPath();ctx.moveTo(pad,y);ctx.lineTo(W-pad,y);ctx.stroke();}
    const bw=(W-pad*2)/bars.length*.52;
    bars.forEach((b,i)=>{
      const x=pad+(W-pad*2)*(i+.5)/bars.length-bw/2;
      const h=(H-pad*2)*(b.value/max); const y=H-pad-h;
      ctx.fillStyle=b.color; ctx.beginPath(); if(ctx.roundRect) ctx.roundRect(x,y,bw,h,10); else ctx.rect(x,y,bw,h); ctx.fill();
      ctx.fillStyle='#344054';ctx.font='14px -apple-system';ctx.textAlign='center';ctx.fillText(b.label,x+bw/2,H-16);ctx.fillText(safeMil(b.value),x+bw/2,Math.max(24,y-8));
    }); ctx.textAlign='left';
  }

  function updateReportV24(){
    const report=byId('clientReport'); if(!report) return;
    setText('reportClientName', byId('clientName')?.value || 'Klient');
    setText('reportClientMeta', numberVal('age')+' let → renta od '+numberVal('rentAge')+' let');
    setText('reportCurrentInvestments', safeFmt(money('lump')));
    setText('reportCurrentAssets', safeFmt(money('current')));
    const mort=mortgageModel();
    setText('reportMortgageDebt', safeFmt(mort.amount||money('mortgageAmount')));
    setText('reportTargetRent', safeFmt(Math.max(money('rent1'),money('rent2')))+' / měsíc');

    let capI=0, capD=0, exitValue=0, investFV=0;
    try{capI=requiredCapitalInterest()}catch(e){}
    try{capD=requiredCapitalDeplete()}catch(e){}
    try{exitValue=currentFutureValue()}catch(e){exitValue=money('current')}
    try{investFV=lumpFutureValue()}catch(e){investFV=money('lump')}
    setText('reportCapitalInterest', safeFmt(capI));
    setText('reportCapitalDeplete', safeFmt(capD));
    setText('reportExitValue', safeFmt(exitValue));
    setText('reportCapitalGap', safeFmt(Math.max(0,capD-exitValue-investFV)));

    const age=numberVal('age'), rentAge=numberVal('rentAge'), endAge=numberVal('endAge');
    const invSeries=[];
    const start=money('current')+money('lump');
    invSeries.push({x:0,cap:start,target:capD});
    invSeries.push({x:Math.max(1,rentAge-age),cap:exitValue+investFV,target:capD});
    invSeries.push({x:Math.max(2,endAge-age),cap:capD,target:capD});
    drawLine(byId('reportInvestChart'),invSeries,[{key:'cap',color:'#16a34a'},{key:'target',color:'#2563eb'}]);

    setText('reportMortgagePayment', safeFmt(mort.payment));
    setText('reportMortgageCross', mort.cross ? monthsToLabel(mort.cross.month) : 'neprotne se');
    setText('reportMortgageSafe', mort.safePayoff ? monthsToLabel(mort.safePayoff.month) : 'nedosáhne');
    const diff=(mort.payoffEndInvestment==null)?null:mort.payoffEndInvestment-mort.baseEndInvestment;
    setText('reportMortgageDiff', diff==null?'—':(diff>=0?'+':'−')+safeFmt(Math.abs(diff)));
    drawLine(byId('reportMortgageChart'),mort.series.map(d=>({x:d.year,debt:d.debt,investment:d.investment,payoffInvestment:d.payoffInvestment})),[
      {key:'debt',color:'#ef4444'}, {key:'investment',color:'#16a34a'}, {key:'payoffInvestment',color:'#2563eb'}
    ]);

    const rn=reportRiskNumbers();
    setText('reportInvalidGap', safeFmt(rn.invalidGap)+' / měsíc');
    setText('reportDeathGap', safeFmt(rn.deathGap)+' / měsíc');
    setText('reportInvalidCover', safeFmt(rn.invalidCover));
    setText('reportDeathCover', safeFmt(rn.deathCover));
    setText('reportUsableAssets', safeFmt(rn.currentAssets));
    setText('reportStateBenefits', 'Inv. '+safeFmt(rn.invalidPension)+' / rodina '+safeFmt(rn.familyPensions));
    drawBars(byId('reportRiskChart'),[
      {label:'Renta',value:Math.max(money('rent1'),money('rent2')),color:'#2563eb'},
      {label:'Inv. důchod',value:rn.invalidPension,color:'#16a34a'},
      {label:'Invalidita chybí',value:rn.invalidGap,color:'#ef4444'},
      {label:'Rodina chybí',value:rn.deathGap,color:'#f59e0b'}
    ]);

    // klientsky čisté doplnění rozkladu pojištění
    const riskSection=byId('reportRiskSection');
    if(riskSection && !byId('riskBreakdownV24')){
      const div=document.createElement('div'); div.id='riskBreakdownV24'; div.className='reportMiniGrid';
      div.innerHTML='<div class="reportKpi blue"><small>Smrt – hypotéka k doplacení</small><strong id="rbMortgageDebt">—</strong></div><div class="reportKpi red"><small>Výdaje + ostatní úvěry</small><strong id="rbFamilyExpenses">—</strong></div><div class="reportKpi green"><small>Státní dávky rodině</small><strong id="rbFamilyBenefits">—</strong></div>';
      const p=document.createElement('p'); p.className='reportLineNote'; p.id='riskNoteV24';
      const anchor=riskSection.querySelector('.reportSplit'); anchor?.after(div); div.after(p);
    }
    setText('rbMortgageDebt',safeFmt(rn.mortgage.amount||0));
    setText('rbFamilyExpenses',safeFmt(rn.expenses+rn.otherLoans)+' / měsíc');
    setText('rbFamilyBenefits',safeFmt(rn.familyPensions)+' / měsíc');
    setText('riskNoteV24','U úmrtí model počítá se splacením hypotéky jednorázově a s měsíčním výpadkem rodiny po započtení vdovského/vdoveckého a sirotčího důchodu.');

    const showInvest=byId('reportInvest')?.checked;
    const showMortgage=byId('reportMortgage')?.checked;
    const showRisk=byId('reportRisk')?.checked;
    byId('reportInvestSection')?.classList.toggle('hidden',!showInvest);
    byId('reportMortgageSection')?.classList.toggle('hidden',!showMortgage);
    byId('reportRiskSection')?.classList.toggle('hidden',!showRisk);
  }

  window.updateReport = updateReportV24;
  const oldSwitch=window.switchTab;
  window.switchTab=function(tab){ if(typeof oldSwitch==='function') oldSwitch(tab); if(tab==='report') setTimeout(updateReportV24,60); };
  ['reportInvest','reportMortgage','reportRisk'].forEach(id=>byId(id)?.addEventListener('change',updateReportV24));
  document.querySelectorAll('input,select').forEach(el=>el.addEventListener('input',()=>setTimeout(updateReportV24,50)));
  setTimeout(updateReportV24,150);
})();


// V25 – mazání údajů klienta
(function(){
  const byId = id => document.getElementById(id);
  const moneyIds = new Set(['rent1','rent2','legacy','current','rentalIncome','lump','riskIncome','riskExpenses','riskOtherLoans','riskInvalidPension','riskWidowPension','riskOrphanPension','riskCurrentInvalidCover','riskCurrentDeathCover','mortgageAmount','mortgageLumpInvest','mortgageMonthlyInvest']);

  const sections = {
    invest: {
      ids: ['clientName','age','rentAge','rent1','rent1Until','rent2From','rent2','endAge','pre','post','legacy','current','currentYield','rentalIncome','lump'],
      values: {
        clientName:'', age:'35', rentAge:'50', rent1:'0', rent1Until:'75', rent2From:'75', rent2:'0', endAge:'90', pre:'8', post:'7', legacy:'0', current:'0', currentYield:'3', rentalIncome:'0', lump:'0'
      }
    },
    risk: {
      ids: ['riskIncomeType','riskIncome','riskExpenses','riskOtherLoans','riskInvalidPension','riskWidowPension','riskOrphanPension','riskChildren','riskCurrentInvalidCover','riskCurrentDeathCover','riskAutoPensions'],
      values: {
        riskIncomeType:'employee', riskIncome:'0', riskExpenses:'0', riskOtherLoans:'0', riskInvalidPension:'0', riskWidowPension:'0', riskOrphanPension:'0', riskChildren:'0', riskCurrentInvalidCover:'0', riskCurrentDeathCover:'0', riskAutoPensions:true
      }
    },
    mortgage: {
      ids: ['mortgageAmount','mortgageRate','mortgageYears','mortgageLumpInvest','mortgageMonthlyInvest','mortgageInvestYield'],
      values: {
        mortgageAmount:'0', mortgageRate:'4.89', mortgageYears:'30', mortgageLumpInvest:'0', mortgageMonthlyInvest:'0', mortgageInvestYield:'7'
      }
    },
    report: {
      ids: ['reportInvest','reportMortgage','reportRisk'],
      values: {reportInvest:true, reportMortgage:true, reportRisk:true}
    }
  };

  function formatMoney(v){
    const clean = String(v ?? '').replace(/\s/g,'').replace(/[^0-9]/g,'');
    if(clean === '') return '';
    return Number(clean).toLocaleString('cs-CZ');
  }

  function setField(id,value){
    const el = byId(id);
    if(!el) return;
    if(el.type === 'checkbox'){
      el.checked = Boolean(value);
    } else {
      el.value = moneyIds.has(id) ? formatMoney(value) : String(value ?? '');
    }
    el.dispatchEvent(new Event('input',{bubbles:true}));
    el.dispatchEvent(new Event('change',{bubbles:true}));
  }

  function recalcAll(){
    try{ if(typeof calculate === 'function') calculate(); }catch(e){}
    try{ if(typeof calculateMortgage === 'function') calculateMortgage(); }catch(e){}
    try{ if(typeof calculateRisk === 'function') calculateRisk(); }catch(e){}
    try{ if(typeof updateReport === 'function') updateReport(); }catch(e){}
    try{ if(typeof updateReportV24 === 'function') updateReportV24(); }catch(e){}
  }

  function clearSection(name){
    const section = sections[name];
    if(!section) return;
    section.ids.forEach(id=>setField(id, section.values[id]));
    recalcAll();
  }

  function activeSection(){
    if(!byId('investPage')?.classList.contains('hidden')) return 'invest';
    if(!byId('riskPage')?.classList.contains('hidden')) return 'risk';
    if(!byId('mortgagePage')?.classList.contains('hidden')) return 'mortgage';
    if(!byId('reportPage')?.classList.contains('hidden')) return 'report';
    return 'invest';
  }

  window.clearCurrentClientPage = function(){
    const sectionName = activeSection();
    const label = {invest:'Investice', risk:'Pojištění', mortgage:'Hypotéka', report:'Report'}[sectionName] || 'aktuální karta';
    if(!confirm('Vymazat údaje z aktuální karty: '+label+'?')) return;
    clearSection(sectionName);
  };

  window.clearAllClientData = function(){
    if(!confirm('Vymazat všechna aktuálně vyplněná klientská data ve všech kartách?')) return;
    ['invest','risk','mortgage','report'].forEach(clearSection);
    recalcAll();
  };
})();
</script>

