function requiredCapitalFromMonthlySchedule(startAge, endAge, monthlyGapFn, yld){
  const rate = yld || (num('post')/100);
  let capital = 0;
  for(let y=startAge; y<endAge; y++){
    const gap = Math.max(0, monthlyGapFn(y));
    const annual = gap * 12;
    capital += annual / Math.pow(1 + rate, Math.max(0, y - startAge));
  }
  return Math.ceil(capital);
}

function calculateRisk(){
  if(!document.getElementById('riskIncome')) return;
  autoUpdateRiskPensions();

  const rentNeed = getNetRentNeed();
  const currentAssetNow = num('current');
  const currentInvestmentsNow = num('lump');
  const usableAssetsNow = currentAssetNow + currentInvestmentsNow;
  const m = document.getElementById('mortgageAmount') ? mortgageInputs() : {payment:0, amount:0};
  const mortgagePaymentValue = m.payment || 0;
  const mortgageDebtValue = m.amount || 0;

  const expenses = num('riskExpenses');
  const otherLoans = num('riskOtherLoans');
  const invalidPension = num('riskInvalidPension');
  const widowPension = num('riskWidowPension');
  const orphanPension = num('riskOrphanPension');
  const children = Math.max(0, val('riskChildren'));
  const currentAge = Math.max(0, num('age'));
  const endAgeValue = Math.max(currentAge + 1, num('endAge'));

  // Invalidita: klient se okamžitě přesouvá do rentového režimu.
  // Potřebný kapitál dnes kryje rentu od aktuálního věku až do konce plánu.
  const invalidGap = Math.max(0, Math.max(num('rent1'), num('rent2')) - num('rentalIncome') - invalidPension);
  const invalidCapital = requiredCapitalFromMonthlySchedule(currentAge, endAgeValue, (age)=>Math.max(0, grossRentAtAge(age) - num('rentalIncome') - invalidPension), num('post')/100);

  // Smrt: cílem je splacení hypotéky + kapitál, který rodině nahradí měsíční výpadek výdajů.
  // Hypoteční splátka není v běžných výdajích, protože hypotéka se má při smrti umořit kapitálem.
  const familyPensions = widowPension + orphanPension * children;
  const deathGap = Math.max(0, expenses + otherLoans - familyPensions);
  const deathIncomeCapital = requiredCapitalFromMonthlySchedule(currentAge, endAgeValue, ()=>deathGap, num('post')/100);
  const deathCapital = mortgageDebtValue + deathIncomeCapital;

  const householdGap = Math.max(0, expenses + mortgagePaymentValue + otherLoans - invalidPension);
  const invalidMissingAfterAssets = Math.max(0, invalidCapital - usableAssetsNow - num('riskCurrentInvalidCover'));
  const deathMissingAfterAssets = Math.max(0, deathCapital - usableAssetsNow - num('riskCurrentDeathCover'));

  riskLoadedRent.textContent = fmt(rentNeed) + ' / měsíc';
  riskLoadedAsset.textContent = fmt(currentAssetNow);
  riskLoadedInvestments.textContent = fmt(currentInvestmentsNow);
  riskLoadedMortgage.textContent = fmt(mortgagePaymentValue) + ' / měsíc / ' + fmt(mortgageDebtValue);

  riskInvalidGap.textContent = fmt(invalidGap);
  riskDeathGap.textContent = fmt(deathGap);
  riskInvalidCapital.textContent = fmt(invalidCapital);
  riskDeathCapital.textContent = fmt(deathCapital);
  riskCoverGap.textContent = fmt(invalidMissingAfterAssets + deathMissingAfterAssets);

  riskSideRent.textContent = fmt(rentNeed) + ' / měsíc';
  riskSideAsset.textContent = fmt(currentAssetNow);
  riskSideInvestments.textContent = fmt(currentInvestmentsNow);
  riskSideMortgage.textContent = fmt(mortgagePaymentValue) + ' / měsíc / ' + fmt(mortgageDebtValue);
  riskSidePensions.textContent = 'Inv. ' + fmt(invalidPension) + ' / vd. ' + fmt(widowPension) + ' / sir. ' + fmt(orphanPension);
  if(typeof riskSideExpenses !== 'undefined') riskSideExpenses.textContent = fmt(expenses) + ' + ' + fmt(otherLoans) + ' + hypo ' + fmt(mortgagePaymentValue) + ' = ' + fmt(expenses + otherLoans + mortgagePaymentValue) + ' / měsíc';

  const invalidCardText = document.querySelector('#riskInvalidGap')?.parentElement?.querySelector('p');
  if(invalidCardText) invalidCardText.innerHTML = 'Chybějící částka k okamžité rentě po započtení invalidního důchodu. Dnešní měsíční rozdíl domácnosti: <strong>' + fmt(householdGap) + ' / měsíc</strong>.';
  if(typeof updateReport === 'function') updateReport();
}

function drawSimpleReportLine(canvas, series, keys){
  if(!canvas) return;
  const ctx=canvas.getContext('2d');
  const W=canvas.width,H=canvas.height,pad=42;
  ctx.clearRect(0,0,W,H);
  const values=[];
  series.forEach(d=>keys.forEach(k=>{ if(d[k.key]!==null && d[k.key]!==undefined) values.push(d[k.key]); }));
  const max=Math.max(...values,1)*1.15;
  ctx.strokeStyle="#e4eaf3";ctx.lineWidth=1;
  for(let i=0;i<=3;i++){const y=pad+(H-pad*2)*i/3;ctx.beginPath();ctx.moveTo(pad,y);ctx.lineTo(W-pad,y);ctx.stroke();ctx.fillStyle="#687891";ctx.font="14px -apple-system";ctx.fillText(fmtMil(max-(max*i/3)),8,y+5);}
  keys.forEach(k=>{
    const pts=series.filter(d=>d[k.key]!==null && d[k.key]!==undefined);
    if(!pts.length) return;
    ctx.strokeStyle=k.color;ctx.lineWidth=4;ctx.beginPath();
    pts.forEach((d,i)=>{const x=pad+(W-pad*2)*(d.x/Math.max(1,series[series.length-1].x));const y=pad+(H-pad*2)*(1-d[k.key]/max);if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y);});
    ctx.stroke();
  });
}

function drawReportBar(canvas, bars){
  if(!canvas) return;
  const ctx=canvas.getContext('2d');
  const W=canvas.width,H=canvas.height,pad=46;
  ctx.clearRect(0,0,W,H);
  const max=Math.max(...bars.map(b=>b.value),1)*1.25;
  ctx.strokeStyle="#e4eaf3";ctx.lineWidth=1;
  for(let i=0;i<=3;i++){const y=pad+(H-pad*2)*i/3;ctx.beginPath();ctx.moveTo(pad,y);ctx.lineTo(W-pad,y);ctx.stroke();}
  const bw=(W-pad*2)/bars.length*0.55;
  bars.forEach((b,i)=>{
    const x=pad+(W-pad*2)*(i+.5)/bars.length-bw/2;
    const h=(H-pad*2)*(b.value/max);
    const y=H-pad-h;
    ctx.fillStyle=b.color;ctx.beginPath();ctx.roundRect(x,y,bw,h,10);ctx.fill();
    ctx.fillStyle="#344054";ctx.font="15px -apple-system";ctx.textAlign="center";ctx.fillText(b.label,x+bw/2,H-18);
    ctx.fillText(fmtMil(b.value),x+bw/2,Math.max(22,y-8));
  });
  ctx.textAlign="left";
}

function getReportRiskNumbers(){
  const currentAge = Math.max(0, num('age'));
  const endAgeValue = Math.max(currentAge + 1, num('endAge'));
  const currentAssetNow = num('current');
  const currentInvestmentsNow = num('lump');
  const usableAssetsNow = currentAssetNow + currentInvestmentsNow;
  const m = document.getElementById('mortgageAmount') ? mortgageInputs() : {payment:0, amount:0};
  const invalidPension = num('riskInvalidPension');
  const widowPension = num('riskWidowPension');
  const orphanPension = num('riskOrphanPension');
  const children = Math.max(0, val('riskChildren'));
  const expenses = num('riskExpenses');
  const otherLoans = num('riskOtherLoans');
  const invalidGap = Math.max(0, Math.max(num('rent1'), num('rent2')) - num('rentalIncome') - invalidPension);
  const invalidCapital = requiredCapitalFromMonthlySchedule(currentAge, endAgeValue, (age)=>Math.max(0, grossRentAtAge(age) - num('rentalIncome') - invalidPension), num('post')/100);
  const familyPensions = widowPension + orphanPension * children;
  const deathGap = Math.max(0, expenses + otherLoans - familyPensions);
  const deathIncomeCapital = requiredCapitalFromMonthlySchedule(currentAge, endAgeValue, ()=>deathGap, num('post')/100);
  const deathCapital = (m.amount || 0) + deathIncomeCapital;
  return {
    invalidGap, deathGap, invalidCapital, deathCapital, usableAssetsNow,
    invalidCover: Math.max(0, invalidCapital - usableAssetsNow - num('riskCurrentInvalidCover')),
    deathCover: Math.max(0, deathCapital - usableAssetsNow - num('riskCurrentDeathCover')),
    invalidPension, familyPensions
  };
}

