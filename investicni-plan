<script>
const fmt = n => Math.round(Math.max(0,n)).toLocaleString('cs-CZ') + " Kč";
const fmtMil = n => (Math.round(n/100000)/10).toLocaleString('cs-CZ') + " mil.";
const parseMoney = v => Number(String(v || "").replace(/\s/g,"").replace(/[^0-9]/g,"")) || 0;
const num = id => parseMoney(document.getElementById(id).value);
const val = id => Number(document.getElementById(id).value) || 0;

function formatMoneyValue(v){
  const clean = String(v || "").replace(/\s/g,"").replace(/[^0-9]/g,"");
  if(clean === "") return "";
  return Number(clean).toLocaleString("cs-CZ");
}

function setupMoneyInputs(){
  const ids = ["rent1","rent2","legacy","current","lump","rentalIncome","mortgageAmount","mortgageLumpInvest","mortgageMonthlyInvest","riskIncome","riskExpenses","riskOtherLoans","riskInvalidPension","riskWidowPension","riskOrphanPension","riskCurrentInvalidCover","riskCurrentDeathCover","riskSocialPayment"];
  ids.forEach(id=>{
    const el = document.getElementById(id);
    if(!el) return;

    el.value = formatMoneyValue(el.value);

    el.addEventListener("input", ()=>{
      const start = el.selectionStart;
      const before = el.value;
      const digitsBefore = before.slice(0,start).replace(/\D/g,"").length;
      el.value = formatMoneyValue(el.value);

      let pos = 0, count = 0;
      while(pos < el.value.length && count < digitsBefore){
        if(/\d/.test(el.value[pos])) count++;
        pos++;
      }
      el.setSelectionRange(pos,pos);
      if(typeof calculate === "function") calculate();
      if(typeof calculateMortgage === "function") calculateMortgage();
      if(typeof calculateRisk === "function") calculateRisk();
    });

    el.addEventListener("blur", ()=>{
      el.value = formatMoneyValue(el.value);
      if(typeof calculate === "function") calculate();
      if(typeof calculateMortgage === "function") calculateMortgage();
      if(typeof calculateRisk === "function") calculateRisk();
    });
  });
}

function switchTab(tab){
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  const map = {invest:'Investice', risk:'Pojištění', mortgage:'Hypotéka', report:'Report'};
  [...document.querySelectorAll('.tab')].find(t=>t.textContent.includes(map[tab])).classList.add('active');
  investPage.classList.toggle('hidden',tab!=='invest');
  riskPage.classList.toggle('hidden',tab!=='risk');
  mortgagePage.classList.toggle('hidden',tab!=='mortgage');
  reportPage.classList.toggle('hidden',tab!=='report');
}

function grossRentAtAge(age){
  return age < num('rent1Until') ? num('rent1') : num('rent2');
}

function rentAtAge(age){
  return Math.max(0, grossRentAtAge(age) - num('rentalIncome'));
}

function requiredCapitalInterest(yld=num('post')/100){
  let maxAnnualRent=0;
  for(let y=num('rentAge');y<num('endAge');y++){
    maxAnnualRent=Math.max(maxAnnualRent,rentAtAge(y)*12);
  }
  return Math.ceil(maxAnnualRent / yld + num('legacy'));
}

function simulateDeplete(startCapital, yld=num('post')/100){
  let cap=startCapital;
  for(let y=num('rentAge');y<num('endAge');y++){
    cap = cap * (1+yld) - rentAtAge(y)*12;
    if(cap < 0) return {ok:false,end:cap};
  }
  return {ok:cap>=num('legacy'),end:cap};
}

function requiredCapitalDeplete(yld=num('post')/100){
  let low=0, high=200000000;
  for(let i=0;i<80;i++){
    const mid=(low+high)/2;
    if(simulateDeplete(mid,yld).ok) high=mid; else low=mid;
  }
  return Math.ceil(high);
}


function yearsToRent(){
  return Math.max(0, num('rentAge') - num('age'));
}

function futureCurrentAsset(rate = val('currentYield')/100){
  return num('current') * Math.pow(1 + rate, yearsToRent());
}

function futureLumpInvestment(){
  const months = Math.max(0, yearsToRent()*12);
  const r = num('pre')/100/12;
  let cap = num('lump');
  for(let i=0;i<months;i++) cap = cap*(1+r);
  return cap;
}

function futureExistingCapital(){
  return futureCurrentAsset() + futureLumpInvestment();
}

function reachesTarget(monthly, targetCapital){
  const months=Math.max(0,(num('rentAge')-num('age'))*12);
  const r=num('pre')/100/12;
  let investedCap=num('lump');
  for(let i=0;i<months;i++){
    investedCap = investedCap*(1+r) + monthly;
  }
  let cap = investedCap + futureCurrentAsset();
  return cap >= targetCapital;
}

function neededMonthly(targetCapital){
  let low=0, high=1000000;
  for(let i=0;i<80;i++){
    const mid=(low+high)/2;
    if(reachesTarget(mid,targetCapital)) high=mid; else low=mid;
  }
  return Math.ceil(high);
}

function buildAccumulationSeries(targetCapital, monthly){
  const age=num('age'), rentAge=num('rentAge');
  const months=Math.max(0,(rentAge-age)*12);
  const r=num('pre')/100/12;
  const assetR=val('currentYield')/100/12;
  let investedCap=num('lump');
  let assetCap=num('current');
  let data=[{age:age,cap:investedCap+assetCap}];

  for(let m=1;m<=months;m++){
    investedCap = investedCap*(1+r) + monthly;
    assetCap = assetCap*(1+assetR);
    if(m%12===0 || m===months){
      data.push({age:age+m/12,cap:investedCap+assetCap});
    }
  }

  if(data.length) data[data.length-1].cap = targetCapital;
  return data;
}

function buildInterestSeries(capital){
  const data = buildAccumulationSeries(capital, neededMonthly(capital));
  for(let y=num('rentAge'); y<num('endAge'); y++){
    data.push({age:y+1, cap:capital});
  }
  return data;
}

function buildDepleteSeries(capital){
  const data = buildAccumulationSeries(capital, neededMonthly(capital));
  let cap = capital;
  for(let y=num('rentAge'); y<num('endAge'); y++){
    cap = cap*(1+num('post')/100) - rentAtAge(y)*12;
    data.push({age:y+1, cap:Math.max(0,cap)});
    if(cap<=0) break;
  }
  return data;
}

function drawChart(capInterest, capDeplete){
  const c=chart, ctx=c.getContext('2d');
  ctx.clearRect(0,0,c.width,c.height);
  const W=c.width,H=c.height,pad=58;
  const age=num('age'), rentAge=num('rentAge'), endAge=num('endAge');
  const green=buildInterestSeries(capInterest);
  const blue=buildDepleteSeries(capDeplete);
  const max=Math.max(...green.map(d=>d.cap),...blue.map(d=>d.cap),1)*1.15;

  ctx.strokeStyle="#e4eaf3";ctx.lineWidth=1;
  for(let i=0;i<=4;i++){
    const y=pad+(H-pad*2)*i/4;
    ctx.beginPath();ctx.moveTo(pad,y);ctx.lineTo(W-pad,y);ctx.stroke();
    ctx.fillStyle="#687891";ctx.font="17px -apple-system";
    ctx.fillText(fmtMil(max-(max*i/4)),10,y+6);
  }
  for(let i=0;i<=8;i++){
    const x=pad+(W-pad*2)*i/8;
    ctx.beginPath();ctx.moveTo(x,pad);ctx.lineTo(x,H-pad);ctx.stroke();
  }
  function line(data,color){
    ctx.strokeStyle=color;ctx.lineWidth=4;ctx.beginPath();
    data.forEach((d,i)=>{
      const x=pad+(W-pad*2)*(d.age-age)/(endAge-age);
      const y=pad+(H-pad*2)*(1-d.cap/max);
      if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y);
    });
    ctx.stroke();
    data.forEach((d,i)=>{
      if(i%4===0||i===data.length-1){
        const x=pad+(W-pad*2)*(d.age-age)/(endAge-age);
        const y=pad+(H-pad*2)*(1-d.cap/max);
        ctx.fillStyle=color;ctx.beginPath();ctx.arc(x,y,4,0,Math.PI*2);ctx.fill();
      }
    });
  }
  line(green,"#24a33a");
  line(blue,"#2468ff");

  const rx=pad+(W-pad*2)*(rentAge-age)/(endAge-age);
  ctx.strokeStyle="#93a4bd";ctx.setLineDash([6,6]);ctx.beginPath();ctx.moveTo(rx,pad);ctx.lineTo(rx,H-pad);ctx.stroke();ctx.setLineDash([]);
  ctx.fillStyle="#3f4f66";ctx.font="16px -apple-system";ctx.fillText("Start renty",rx+8,pad+22);

  ctx.fillStyle="#3f4f66";ctx.font="16px -apple-system";
  ctx.fillText(age,pad,H-16);
  ctx.fillText(rentAge,rx-8,H-16);
  ctx.fillText(endAge,W-pad-30,H-16);
}

function calculate(){
  const capI=requiredCapitalInterest();
  const capD=requiredCapitalDeplete();
  const mI=neededMonthly(capI);
  const mD=neededMonthly(capD);
  const currentTotal=num('current')+num('lump');
  const futureAsset=futureCurrentAsset();
  const futureExisting=futureExistingCapital();
  const maxGrossRent=Math.max(num('rent1'),num('rent2'));
  const maxNetRent=Math.max(0,maxGrossRent-num('rentalIncome'));

  capitalInterest.textContent=fmt(capI);
  capitalDeplete.textContent=fmt(capD);
  rentInfo1.textContent=fmt(maxNetRent);
  rentInfo2.textContent=fmt(maxNetRent);

  monthlyInterest.textContent=fmt(mI);
  monthlyDeplete.textContent=fmt(mD);
  existingCapitalValue.textContent=fmt(futureExisting);
  assetInlineValue.textContent=fmt(futureAsset);

  summaryClient.textContent=document.getElementById('clientName').value || 'Klient';
  summaryAge.textContent=num('age') + ' let';
  summaryRentAge.textContent=num('rentAge') + ' let';
  summaryExitAsset.textContent=fmt(futureAsset);

  sideRent.textContent=fmt(maxNetRent) + " / měsíc po pronájmu";
  sideYears.textContent=(num('endAge')-num('rentAge'))+" let ("+num('rentAge')+"–"+num('endAge')+" let)";
  sideYield.textContent=num('pre').toLocaleString('cs-CZ')+" % p.a. investice / "+val('currentYield').toLocaleString('cs-CZ')+" % p.a. majetek";
  sideCurrent.textContent=fmt(currentTotal);
  sideExitAsset.textContent=fmt(futureAsset);
  sideRentalIncome.textContent=fmt(num('rentalIncome')) + " / měsíc";
  gapInterest.textContent=fmt(capI-futureExisting);
  gapDeplete.textContent=fmt(capD-futureExisting);

  const rates=[6,7,8,9,10];
  const assetRates=[2,3,4,5];
  scenarioTable.querySelector('tbody').innerHTML=rates.map((r,idx)=>{
    const i=requiredCapitalInterest((r-1)/100);
    const d=requiredCapitalDeplete((r-1)/100);
    const ar=assetRates[idx] || 5;
    const asset=futureCurrentAsset(ar/100);
    return `<tr><td>${r} %</td><td>${fmtMil(i)}</td><td>${fmtMil(d)}</td><td>${ar} % → ${fmtMil(asset)}</td></tr>`;
  }).join("");

  drawChart(capI,capD);
}


function mortgageInputs(){
  const amount = num('mortgageAmount');
  const annualRate = val('mortgageRate')/100;
  const years = Math.max(1, val('mortgageYears'));
  const monthlyRate = annualRate/12;
  const months = years*12;
  const payment = monthlyRate === 0 ? amount/months : amount * monthlyRate / (1 - Math.pow(1+monthlyRate, -months));
  return {amount, annualRate, years, monthlyRate, months, payment};
}

function buildMortgageSeries(){
  const m = mortgageInputs();
  const invMonthlyRate = val('mortgageInvestYield')/100/12;
  const baseMonthlyInvest = num('mortgageMonthlyInvest');
  const lumpInvest = num('mortgageLumpInvest');

  let debt = m.amount;
  let investment = lumpInvest;
  const series = [{year:0, debt, investment, payoffInvestment:null}];
  let cross = null;
  let safePayoff = null;
  const rentThreshold = (typeof getNetRentNeed === "function" ? getNetRentNeed() : 0);

  for(let month=1; month<=m.months; month++){
    debt = Math.max(0, debt*(1+m.monthlyRate) - m.payment);
    investment = investment*(1+invMonthlyRate) + baseMonthlyInvest;

    if(cross === null && investment >= debt){
      cross = {month, year: month/12, debt, investment};
    }
    if(safePayoff === null && investment >= debt && (investment - debt) >= rentThreshold){
      safePayoff = {month, year: month/12, debt, investment, surplus: investment - debt};
    }

    if(month%12===0 || month===m.months){
      series.push({year:month/12, debt, investment, payoffInvestment:null});
    }
  }

  let payoffEndInvestment = null;
  const payoffMonthlyAfter = baseMonthlyInvest + m.payment;
  const payoffSeries = [];

  if(cross){
    let payoffInvestment = Math.max(0, cross.investment - cross.debt);
    payoffSeries.push({month:cross.month, year:cross.month/12, payoffInvestment});

    for(let month=cross.month+1; month<=m.months; month++){
      payoffInvestment = payoffInvestment*(1+invMonthlyRate) + payoffMonthlyAfter;
      if(month%12===0 || month===m.months){
        payoffSeries.push({month, year:month/12, payoffInvestment});
      }
    }
    payoffEndInvestment = payoffSeries.length ? payoffSeries[payoffSeries.length-1].payoffInvestment : payoffInvestment;
  }

  const byYear = new Map(series.map(d=>[Number(d.year.toFixed(6)), d]));
  payoffSeries.forEach(p=>{
    const key = Number(p.year.toFixed(6));
    if(byYear.has(key)) byYear.get(key).payoffInvestment = p.payoffInvestment;
    else series.push({year:p.year, debt:null, investment:null, payoffInvestment:p.payoffInvestment});
  });
  series.sort((a,b)=>a.year-b.year);

  return {
    series,
    cross,
    safePayoff,
    payment:m.payment,
    totalInterest:m.payment*m.months-m.amount,
    years:m.years,
    baseEndInvestment: investment,
    payoffEndInvestment,
    payoffMonthlyAfter
  };
}

function drawMortgageChart(data){
  const c = document.getElementById('mortgageChart');
  if(!c) return;
  const ctx = c.getContext('2d');
  ctx.clearRect(0,0,c.width,c.height);
  const W=c.width,H=c.height,pad=58;
  const allValues=[];
  data.series.forEach(d=>{
    if(d.debt!==null && d.debt!==undefined) allValues.push(d.debt);
    if(d.investment!==null && d.investment!==undefined) allValues.push(d.investment);
    if(d.payoffInvestment!==null && d.payoffInvestment!==undefined) allValues.push(d.payoffInvestment);
  });
  const max=Math.max(...allValues,1)*1.15;

  ctx.strokeStyle="#e4eaf3";ctx.lineWidth=1;
  for(let i=0;i<=4;i++){
    const y=pad+(H-pad*2)*i/4;
    ctx.beginPath();ctx.moveTo(pad,y);ctx.lineTo(W-pad,y);ctx.stroke();
    ctx.fillStyle="#687891";ctx.font="17px -apple-system";
    ctx.fillText(fmtMil(max-(max*i/4)),10,y+6);
  }
  for(let i=0;i<=8;i++){
    const x=pad+(W-pad*2)*i/8;
    ctx.beginPath();ctx.moveTo(x,pad);ctx.lineTo(x,H-pad);ctx.stroke();
  }
  function line(key,color){
    const points=data.series.filter(d=>d[key]!==null && d[key]!==undefined);
    if(!points.length) return;
    ctx.strokeStyle=color;ctx.lineWidth=4;ctx.beginPath();
    points.forEach((d,i)=>{
      const x=pad+(W-pad*2)*(d.year/data.years);
      const y=pad+(H-pad*2)*(1-d[key]/max);
      if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y);
    });
    ctx.stroke();
  }
  line('debt','#ef4444');
  line('investment','#16a34a');
  line('payoffInvestment','#2563eb');

  if(data.cross){
    const x=pad+(W-pad*2)*(data.cross.year/data.years);
    const y=pad+(H-pad*2)*(1-data.cross.investment/max);
    ctx.strokeStyle="#3f4f66";ctx.setLineDash([6,6]);ctx.beginPath();ctx.moveTo(x,pad);ctx.lineTo(x,H-pad);ctx.stroke();ctx.setLineDash([]);
    ctx.fillStyle="#101828";ctx.beginPath();ctx.arc(x,y,6,0,Math.PI*2);ctx.fill();
    ctx.fillStyle="#3f4f66";ctx.font="16px -apple-system";ctx.fillText("Bod zvratu",x+8,Math.max(pad+22,y-10));
    ctx.fillText("Investice = dluh",x+8,Math.max(pad+42,y+10));
  }

  ctx.fillStyle="#3f4f66";ctx.font="16px -apple-system";
  ctx.fillText("0",pad,H-16);
  ctx.fillText(data.years + " let",W-pad-45,H-16);
}

function calculateMortgage(){
  if(!document.getElementById('mortgageAmount')) return;
  const data=buildMortgageSeries();
  const crossText=data.cross ? (Math.ceil(data.cross.month/12) + ". rok") : "neprotne se";
  const safePayoffText=data.safePayoff ? (Math.ceil(data.safePayoff.month/12) + ". rok") : "nedosáhne";
  const crossValue=data.cross ? fmt(data.cross.investment) : "—";
  const crossDebt=data.cross ? fmt(data.cross.debt) : "—";
  const baseEnd=data.baseEndInvestment || 0;
  const payoffEnd=data.payoffEndInvestment;
  const diff=payoffEnd===null ? null : payoffEnd - baseEnd;

  mortgagePayment.textContent=fmt(data.payment);
  mortgageInterestTotal.textContent=fmt(data.totalInterest);
  mortgageCrossYear.textContent=crossText;
  if(typeof mortgageSafePayoffTop !== 'undefined') mortgageSafePayoffTop.textContent=safePayoffText;
  mortgageNewMonthlyAfterPayoff.textContent=data.cross ? fmt(data.payoffMonthlyAfter) + " / měsíc" : "—";
  mortgageDecisionYear.textContent=crossText;
  mortgageEndInvestCard.textContent=fmt(baseEnd);
  mortgagePayoffInvestCard.textContent=payoffEnd===null ? "—" : fmt(payoffEnd);
  mortgageStrategyDiff.textContent=diff===null ? "—" : (diff>=0 ? "+" : "−") + fmt(Math.abs(diff));
  mortgageFreedPayment.textContent=data.cross ? fmt(data.payoffMonthlyAfter) + " / měsíc" : "—";
  if(typeof mortgageSafePayoffCard !== 'undefined') mortgageSafePayoffCard.textContent=safePayoffText;


  mortgageSideDebt.textContent=fmt(num('mortgageAmount'));
  mortgageSideRateYears.textContent=val('mortgageRate').toLocaleString('cs-CZ') + " % / " + val('mortgageYears') + " let";
  mortgageSideMonthly.textContent=fmt(num('mortgageMonthlyInvest')) + " / měsíc";
  mortgageSideYield.textContent=val('mortgageInvestYield').toLocaleString('cs-CZ') + " % p.a.";
  mortgageSideCrossValue.textContent=crossValue;
  mortgageSideCrossDebt.textContent=crossDebt;
  mortgageSideDiff.textContent=diff===null ? "—" : (diff>=0 ? "+" : "−") + fmt(Math.abs(diff));
  if(typeof mortgageSideSafePayoff !== 'undefined') mortgageSideSafePayoff.textContent=safePayoffText;

  drawMortgageChart(data);
}

function getNetRentNeed(){
  return Math.max(0, Math.max(num('rent1'), num('rent2')) - num('rentalIncome'));
}


function roundToStep(value, step=500){
  return Math.round(value / step) * step;
}

function clamp(value, min, max){
  return Math.max(min, Math.min(max, value));
}

function estimateStatePensionsFromIncome(){
  const income = num('riskIncome');
  const type = document.getElementById('riskIncomeType') ? document.getElementById('riskIncomeType').value : 'employee';
  const extraSocial = document.getElementById('riskExtraSocial')?.checked;
  const socialPayment = num('riskSocialPayment');
  const pausalBand = document.getElementById('riskPausalBand')?.value || '1';

  // Poznámka: přesný důchod umí jen ČSSZ. Tady jde o orientační pracovní model.
  // Zaměstnanec: vychází z čistého příjmu jako proxy pro výdělek.
  // OSVČ: důchod více závisí na vyměřovacím základu pro sociální pojištění než na čistém příjmu.
  // Paušální daň: používá orientační měsíční vyměřovací základ podle pásma paušální daně.
  let pensionBase = income;

  if(type === 'osvc'){
    const minimumBase2026 = 17150; // orientační minimum 2026 po návratu na 35 % průměrné mzdy
    const paidBase = socialPayment > 0 ? socialPayment / 0.292 : 0;
    pensionBase = extraSocial && paidBase > minimumBase2026 ? paidBase : Math.max(minimumBase2026, income * 0.28);
  }

  if(type === 'pausal'){
    const pausalBases2026 = {1:22526, 2:28050, 3:42900};
    const baseFromBand = pausalBases2026[pausalBand] || pausalBases2026[1];
    const paidBase = socialPayment > 0 ? socialPayment / 0.292 : 0;
    pensionBase = extraSocial && paidBase > baseFromBand ? paidBase : baseFromBand;
  }

  const profiles = {
    employee: {invalid:0.50, widow:0.33, orphan:0.22, minI:16000, maxI:45000, minW:12000, maxW:30000, minO:8000, maxO:20000},
    osvc:     {invalid:0.68, widow:0.45, orphan:0.32, minI:11000, maxI:36000, minW:9000,  maxW:26000, minO:6000, maxO:18000},
    pausal:   {invalid:0.68, widow:0.45, orphan:0.32, minI:11000, maxI:36000, minW:9000,  maxW:26000, minO:6000, maxO:18000}
  };
  const p = profiles[type] || profiles.employee;
  const invalid = roundToStep(clamp(pensionBase * p.invalid, p.minI, p.maxI));
  const widow = roundToStep(clamp(pensionBase * p.widow, p.minW, p.maxW));
  const orphan = roundToStep(clamp(pensionBase * p.orphan, p.minO, p.maxO));
  return {invalid, widow, orphan, pensionBase};
}

